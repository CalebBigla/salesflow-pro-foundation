# SalesFlow Pro — example environment file.
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Backend project URL and public (anon/publishable) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Browser-visible copies used by the Vite client. Same values as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security — never expose to the browser
# and never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=
